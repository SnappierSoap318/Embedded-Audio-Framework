menuconfig EAF
	bool "Embedded Audio Framework"
	default y
	select REQUIRES_STD_C11

if EAF
config EAF_THREAD_COUNT
	int "Maximum simultaneous EAF worker threads"
	default 2
	range 1 8
config EAF_THREAD_STACK_SIZE
	int "Worker stack size in bytes"
	default 4096
	range 2048 65536
config EAF_DECODER_PRIORITY
	int "Decoder preemptive priority"
	default 5
	range 0 14
config EAF_AUDIO_PRIORITY
	int "Audio preemptive priority (must be lower numerically than decoder)"
	default 3
	range 0 13
config EAF_SEM_COUNT
	int "Maximum EAF binary wake semaphores"
	default 4
	range 1 16
config EAF_LMS
	bool "Bounded SlimProto control protocol"
	default y
config EAF_I2S
	bool "Static stereo I2S TX sink"
	depends on I2S
config EAF_LMS_CLIENT
	bool "LMS TCP/HTTP raw PCM client"
	depends on EAF_LMS && NET_SOCKETS
config EAF_LMS_INGRESS_BYTES
	int "Raw PCM ingress ring bytes for the LMS client"
	default 4096
	range 1024 65536
	depends on EAF_LMS_CLIENT
	help
	  Fixed raw source-PCM buffer between the socket and the output callback.
	  The transport keeps draining the socket into this ring while the output
	  reservoir is backpressured, so the server's TCP window stays open. Boards
	  without PSRAM should size it within internal RAM.
config EAF_BT_A2DP
	bool "Zephyr Classic A2DP SBC sink binding"
	depends on EAF_BT_INGRESS && BT_CLASSIC && BT_A2DP_SINK
	help
	  Register a fixed-rate SBC endpoint and copy incoming media to EAF.
	  The board application owns SDP, pairing and decoder/audio workers.
config EAF_BT_SBC
	bool "SBC decode worker"
	depends on EAF_BT_INGRESS && ZEPHYR_LIBSBC_MODULE
	select LIBSBC_DECODER
config EAF_I2S_MAX_FRAMES
	int "Maximum I2S block frames"
	default 256
	range 32 1024
	depends on EAF_I2S
config EAF_BT_INGRESS
	bool "Bounded Bluetooth SBC media ingress"
	default y
endif
