mainmenu "EAF WROOM Sendspin player"
config EAF_I2S_MAX_FRAMES
    default 128
source "Kconfig.zephyr"
config EAF_BOARD_I2S
    bool "Audible I2S output (otherwise timed null)"
    default y
    select I2S
    select EAF_I2S
config EAF_BOARD_NAME
    string "Player name advertised to the server"
    default "EAF Sendspin"
    help
      Human-readable name shown in Music Assistant. Set a distinct value per
      board so multiple players are easy to tell apart.

config EAF_BOARD_CLIENT_ID
    string "Sendspin client identifier"
    default "eaf-sendspin"
    help
      Stable identifier for this player. Changing it makes the server treat
      the board as a new player.

config EAF_BOARD_SERVER
    string "Sendspin server numeric IPv4 address"
    default ""
    help
      Music Assistant host IPv4 address. Required; the board logs an error and
      stops when it is empty. Provide it locally, for example with a local
      override file passed as -DEXTRA_CONF_FILE=local.conf containing
      CONFIG_EAF_BOARD_SERVER="192.168.1.10".
config EAF_BOARD_PORT
    int "Sendspin server port"
    default 8927
    range 1 65535
config EAF_SOURCE_CHANNELS
    int "Source PCM channels advertised to the server"
    default 2
    range 1 2
    help
      Ask Music Assistant to send this many channels. The board still outputs
      stereo (the producer duplicates one channel when mono), but the network
      rate drops when set to 1, which is more reliable on throughput-limited
      2.4 GHz Wi-Fi.

choice EAF_BIT_DEPTH_CHOICE
    prompt "Source PCM bit depth advertised to the server"
    default EAF_BIT_DEPTH_16
    help
      Precision of the PCM the server sends. The board always presents 32-bit
      Q1.31 to the I2S sink; the network rate grows with the chosen precision.

config EAF_BIT_DEPTH_16
    bool "16-bit"
config EAF_BIT_DEPTH_24
    bool "24-bit"
config EAF_BIT_DEPTH_32
    bool "32-bit"
endchoice

config EAF_BIT_DEPTH
    int
    default 16 if EAF_BIT_DEPTH_16
    default 24 if EAF_BIT_DEPTH_24
    default 32 if EAF_BIT_DEPTH_32

config EAF_SAMPLE_RATE
    int "Source sample rate advertised to the server"
    default 44100
    range 8000 192000
    help
      Music Assistant transcodes to this rate. Lowering it (for example 22050)
      further reduces the network rate when even mono 44.1 kHz is marginal.

config EAF_AMP_PWDN_GPIO
    int "TAS5805M PDN GPIO (amplifier enable)"
    default 33
    range 0 39
config EAF_AMP_FAULT_GPIO
    int "TAS5805M FAULT GPIO (input)"
    default 34
    range 0 39
config EAF_BOARD_RATE_CONTROL
    bool "Hold presentation latency with drift resampling"
    default y
    help
      Resample the PCM written to the sink to hold the measured Sendspin
      presentation latency at the reported lead time. Required for synchronized
      multiroom playback; the correction is bounded to a few hundred ppm.

config EAF_BOARD_WIFI_PS_NONE
    bool "Disable Wi-Fi modem sleep for lower latency"
    default y
    help
      ESP-IDF defaults to WIFI_PS_MIN_MODEM, which wakes only at the AP DTIM
      period. On a mains-powered player, disabling power save removes those
      periodic receive stalls at the cost of higher idle current.
config EAF_BOARD_AUDIO_CPU
    int "Audio worker CPU (-1 unrestricted)"
    default -1
    help
      With CONFIG_SMP and CONFIG_SCHED_CPU_MASK, pin the audio owner to this
      CPU so network work cannot preempt it. -1 leaves it unrestricted.
config EAF_BOARD_MAIN_CPU
    int "Main/transport CPU (-1 unrestricted)"
    default -1
config EAF_BOARD_RESERVOIR_FRAMES
    int "Output reservoir capacity in frames (power of two)"
    default 4096
    range 512 1048576
    help
      Stereo Q1.31 output reservoir capacity. Also caps the startup prefill.
      Must be a power of two.
config EAF_BOARD_USE_PSRAM
    bool "Place the output reservoir in external SPI RAM"
    default n
    depends on ESP_SPIRAM
    help
      Allocate the reservoir from the ESP32 external RAM shared heap. Enables
      the large-buffer WROVER profile; requires CONFIG_ESP_SPIRAM and PSRAM.
